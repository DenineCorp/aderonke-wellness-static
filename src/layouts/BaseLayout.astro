---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { isPreview } from '../lib/site';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	jsonLd?: Record<string, unknown>;
	ogImage?: string;
}
const { title, description, jsonLd, ogImage } = Astro.props;
const currentPath = Astro.url.pathname;
const fullTitle = `${title} · Aderonke Wellness`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://aderonke-wellness.netlify.app');
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
	<title>{fullTitle}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={canonicalURL} />
	{isPreview && <meta name="robots" content="noindex, nofollow" />}
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

	<meta property="og:site_name" content="Aderonke Wellness" />
	<meta property="og:title" content={fullTitle} />
	<meta property="og:description" content={description} />
	<meta property="og:type" content="website" />
	<meta property="og:url" content={canonicalURL} />
	{ogImage && <meta property="og:image" content={ogImage} />}
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={fullTitle} />
	<meta name="twitter:description" content={description} />

	{jsonLd && (
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	)}
</head>
<body>
	{isPreview && (
		<div class="aw-preview-banner">
			Preview version for your review. Not yet public.
		</div>
	)}
	<Header currentPath={currentPath} />
	<main id="aw-main">
		<slot />
	</main>
	<Footer />
</body>
</html>
