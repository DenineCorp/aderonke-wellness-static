---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedArticles } from '../../lib/site';

const articles = (await getPublishedArticles()).filter((a) => a.data.pillar === 'caregiver-support');
---

<BaseLayout
	title="Caregiver Support"
	description="Recognizing burnout, navigating family dynamics, and finding real support for family caregivers of aging loved ones."
>
	<header class="aw-container aw-section">
		<h1 class="aw-pillar-heading"><Icon name="caregiver-support" /> Caregiver Support</h1>
		<div class="aw-article-body">
			<p>Caring for an aging parent, spouse, or loved one is one of the most demanding roles a person can take on, usually unpaid, often unplanned, and rarely talked about honestly. Nearly 1 in 4 American adults now provides this kind of care, and most are doing it while also working a job and raising their own family.</p>
			<p>This section is for the caregiver, not just the person they're caring for: recognizing burnout before it becomes a crisis, navigating family disagreements about care, and finding real support, practical, financial, and emotional, for the stage you're in.</p>
			<p>Every article here is written or reviewed by Aderonke Agboji, RN, PhD Candidate in Health Sciences, drawing on two decades of hands-on long-term care experience. See our <a href="/editorial-policy/">Editorial Policy</a> for how we research and review.</p>
		</div>
	</header>

	<div class="aw-container aw-section">
		<div class="aw-card-grid">
			{articles.map((article) => <ArticleCard article={article} />)}
		</div>
	</div>
</BaseLayout>
