---
/**
 * Brand wordmark (Round 2 brand layer): a small restrained leaf mark
 * plus the site name set in the existing display serif. One colour via
 * currentColor so it reads correctly on both cream and deep-anchor
 * backgrounds (header vs. footer) without a separate light variant.
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg
	class={`aw-wordmark ${className ?? ''}`}
	viewBox="0 0 224 32"
	role="img"
	aria-label="Aderonke Wellness"
	xmlns="http://www.w3.org/2000/svg"
>
	<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
		<path d="M14 3c5.3 3.1 7.3 9.1 4.2 15.1C12 17.3 7.5 12.7 14 3z" />
		<path d="M14 3.4c-1.1 5.4-1 10.4 2.3 15.4" />
	</g>
	<text x="32" y="23" font-family="'Fraunces', Georgia, 'Times New Roman', serif" font-size="19" font-weight="500" fill="currentColor">Aderonke Wellness</text>
</svg>
