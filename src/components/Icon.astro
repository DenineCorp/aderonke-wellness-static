---
/**
 * Small custom line-icon set (brand layer, Round 2): one consistent
 * stroke style, no fill, single colour via currentColor. Covers the
 * three audiences (seniors, caregivers, care-staff) and three content
 * categories (mental-wellness, dementia-care, caregiver-support).
 */
interface Props {
	name: 'seniors' | 'caregivers' | 'care-staff' | 'mental-wellness' | 'dementia-care' | 'caregiver-support';
}
const { name } = Astro.props;
---

<svg
	class="aw-icon"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	role="img"
	aria-hidden="true"
>
	{name === 'seniors' && (
		<>
			<circle cx="12" cy="7.5" r="3.2" />
			<path d="M5.5 20c0-4.4 2.9-6.8 6.5-6.8s6.5 2.4 6.5 6.8" />
		</>
	)}
	{name === 'caregivers' && (
		<>
			<circle cx="8.8" cy="7" r="2.6" />
			<circle cx="15.6" cy="8.4" r="2.2" />
			<path d="M3.8 20c0-3.8 2.3-5.9 5-5.9c1.1 0 2.1.3 2.9.9" />
			<path d="M11.2 20.2c.2-3.2 2.1-5.4 5-5.4c2.6 0 4.6 1.9 5 4.9" />
		</>
	)}
	{name === 'care-staff' && (
		<>
			<path d="M12 3.2l6.5 2.4v5.2c0 4.7-2.8 7.9-6.5 9.4-3.7-1.5-6.5-4.7-6.5-9.4V5.6L12 3.2z" />
			<path d="M12 9v5M9.5 11.5h5" />
		</>
	)}
	{name === 'mental-wellness' && (
		<>
			<path d="M18.5 5.2c.9 6.6-2.4 12.3-8.9 13.4C8.1 12 10.9 6.6 18.5 5.2z" />
			<path d="M10 18c2-4 4.5-7.4 8.2-11.4" />
		</>
	)}
	{name === 'dementia-care' && (
		<>
			<path d="M9 20v-2.6c-2.4-1.3-4-3.8-4-6.6 0-4.3 3.6-7.8 8-7.8s7.5 3.3 7.9 7.5c.3 3-1 5.6-3.4 7.1V20" />
			<path d="M13.8 20h-3.6" />
			<path d="M10.5 10.3c0-1 .9-1.7 1.8-1.4c.9.3 1 1.5.2 2c-.9.5-.8 1.8.3 2" />
		</>
	)}
	{name === 'caregiver-support' && (
		<>
			<path d="M4 14c0-1.8 1.4-3 3-3c1 0 1.8.4 2.4 1.1" />
			<path d="M20 14c0-1.8-1.4-3-3-3c-1 0-1.8.4-2.4 1.1" />
			<path d="M4 14v2c0 2.4 2 4.3 4.4 4.3h7.2c2.4 0 4.4-1.9 4.4-4.3v-2" />
			<path d="M12 10.3c-1-1.6-3.4-1.6-3.9.2c-.4 1.5 1.1 2.6 3.9 4.5c2.8-1.9 4.3-3 3.9-4.5c-.5-1.8-2.9-1.8-3.9-.2z" />
		</>
	)}
</svg>
