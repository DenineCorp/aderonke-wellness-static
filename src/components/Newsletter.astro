---
/**
 * Renders a real signup form once PUBLIC_KIT_FORM_ID is set in Netlify's
 * environment variables. Until then, renders nothing on production (per
 * the homepage spec: "Newsletter signup — only if connected to Kit") —
 * a clean one-line placeholder shows only in preview mode, so reviewers
 * know the section exists without a dead form reaching real visitors.
 */
import { isPreview } from '../lib/site';

const kitFormId = import.meta.env.PUBLIC_KIT_FORM_ID || '';
---

{kitFormId ? (
	<div class="aw-newsletter">
		<h2>Get new articles by email</h2>
		<p>No spam, unsubscribe anytime. We’ll never share your email.</p>
		<form method="post" action={`https://app.convertkit.com/forms/${kitFormId}/subscriptions`}>
			<label for="email_address" class="screen-reader-text">Email address</label>
			<input type="email" id="email_address" name="email_address" required placeholder="you@example.com" />
			<button type="submit" class="aw-btn">Subscribe</button>
		</form>
	</div>
) : isPreview ? (
	<div class="aw-newsletter" style="background: var(--aw-color-bg-alt); color: var(--aw-color-text); border: 1px dashed var(--aw-color-border);">
		<h2 style="color: var(--aw-color-text);">Newsletter coming soon</h2>
		<p style="font-size: 0.85rem;">(Preview only. Hidden until the newsletter is connected.)</p>
	</div>
) : null}
