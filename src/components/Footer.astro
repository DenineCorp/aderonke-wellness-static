---
import Wordmark from './Wordmark.astro';

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/mental-wellness/', label: 'Mental Wellness' },
	{ href: '/dementia-care/', label: 'Dementia & Cognitive Care' },
	{ href: '/caregiver-support/', label: 'Caregiver Support' },
	{ href: '/about/', label: 'About Me' },
	{ href: '/contact/', label: 'Contact' },
];
const legalLinks = [
	{ href: '/privacy-policy/', label: 'Privacy Policy' },
	{ href: '/disclaimer/', label: 'Disclaimer' },
	{ href: '/editorial-policy/', label: 'Editorial Policy' },
	{ href: '/resources/', label: 'Resources' },
];
const year = new Date().getFullYear();
---

<footer class="aw-site-footer">
	<div class="aw-container">
		<div class="aw-footer-top">
			<div class="aw-footer-brand">
				<a class="aw-logo" href="/" aria-label="Aderonke Wellness, home">
					<Wordmark />
				</a>
				<p>Nursing-informed guidance on mental wellness, dementia care, and caregiving, for seniors and the families who support them.</p>
			</div>

			<nav class="aw-footer-nav" aria-label="Footer">
				<ul>
					{navLinks.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
			</nav>

			<!-- Social icons intentionally omitted: no real profile URLs are
			     configured yet. Same "hide, don't link to #" rule as the
			     WordPress build, see inc/template-helpers.php there. -->
		</div>

		<div class="aw-footer-crisis">
			<strong>In crisis?</strong> Call or text <strong>9-8-8</strong> to reach the Suicide Crisis Helpline, free and available 24/7 across Canada.
		</div>

		<div class="aw-footer-bottom">
			<nav class="aw-footer-legal" aria-label="Legal">
				<ul>
					{legalLinks.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
			</nav>
			<p class="aw-footer-copy">
				&copy; {year} Aderonke Wellness. All content is for informational purposes only and is not medical advice.
			</p>
		</div>
	</div>
</footer>
